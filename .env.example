# Canonical multi-device runtime. The YAML stores only environment-variable names.
DEVICES_FILE=config/devices.yaml

# Secret values referenced by the two preserved adapter examples in devices.yaml.
# Leave blank until the matching device is configured; never commit the real .env.
TAPO_USER=
TAPO_PASS=
MAINFLUX_THING_KEY=
HVIP01_MAINFLUX_THING_KEY=
# HVIP01_ADB_SERIAL=

# tools.add_device generates names such as the following for new devices and writes
# values through hidden prompts. These examples intentionally contain no secret.
# CAMERA_AGENT_RTSP_LOBBY_01_RTSP_USER=
# CAMERA_AGENT_RTSP_LOBBY_01_RTSP_PASS=
# CAMERA_AGENT_RTSP_LOBBY_01_MAINFLUX_THING_KEY=

# CPU-friendly defaults for an Intel i5-8250U / 8 GB RAM machine.
PROCESS_INTERVAL=1.0
DETECTOR_IMAGE_SIZE=416
TORCH_THREADS=2
SHOW_PREVIEW=true
PREVIEW_MODE=compact
PREVIEW_MAX_WIDTH=1280
PREVIEW_MAX_HEIGHT=720
SHOW_CLASSIFIER_PREVIEW=false

# Optional single-source compatibility path. New devices should use devices.yaml.
# RTSP_ADAPTER=generic
# RTSP_HOST=192.0.2.10
# RTSP_PORT=554
# RTSP_PATH=Streaming/Channels/101
# RTSP_USERNAME=
# RTSP_PASSWORD=
# RTSP_URL=                    # May include credentials; never commit or log it.
# MONITOR_ROI=0.15,0.20,0.55,0.60

COMPUTER_CONFIDENCE=0.35
HISTORY_SIZE=8
MINIMUM_HISTORY=6
MINIMUM_ACTIVE_FRAMES=5
ACTIVE_FRAME_THRESHOLD=0.55
ACTIVE_MIN_MARGIN=0.20
ACTIVATE_AVERAGE=0.72
DEACTIVATE_AVERAGE=0.35

# Mainflux is required for normal operation. Each enabled manifest device references
# a different Thing-key environment variable. Use --dry-run only while calibrating.
MAINFLUX_ENABLED=true
MAINFLUX_URL=http://localhost
MAINFLUX_MESSAGES_PATH=/http/messages
MAINFLUX_AUTH_SCHEME=Thing
MAINFLUX_HEARTBEAT=30
MAINFLUX_RETRY_BACKOFF=10
MAINFLUX_VERIFY_TLS=true
MAINFLUX_OUTBOX_PATH=runtime/mainflux-outbox.sqlite3

# Local temporal/cooldown rules. Per-device overrides live in the manifest.
RULES_FILE=config/rules.toml

# Privacy-first: no employee screen image is persisted by default.
SAVE_EVIDENCE=false
EVIDENCE_RETENTION_DAYS=7
